{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/../scripts/hooks/block_edits_on_main.cjs\"",
            "timeout": 15,
            "statusMessage": "Checking branch (no edits on main)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/../scripts/hooks/door_from_spirality.cjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
