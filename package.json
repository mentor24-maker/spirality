{
  "name": "spirality",
  "version": "0.0.1",
  "private": true,
  "description": "Alphire Spirality — the AI development system: the shared loop that builds StarCaster, WaveCenter and itself.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    "./lib/*": "./lib/*.js",
    "./lib/*.js": "./lib/*.js",
    "./lib/*.mjs": "./lib/*.mjs",
    "./lib/projectConfig": "./lib/projectConfig.mjs"
  },
  "files": [
    "lib/",
    "scripts/",
    "docs/"
  ],
  "scripts": {
    "clickup": "node scripts/with_doppler.mjs node scripts/clickup.mjs",
    "tracker:account": "node scripts/with_doppler.mjs node --no-warnings tracker/account.mjs",
    "tracker:import": "node scripts/with_doppler.mjs node tracker/import.mjs",
    "doctor": "node scripts/doctor.mjs",
    "tracker:old-id": "node --disable-warning=ExperimentalWarning tracker/oldId.mjs",
    "tracker:signins": "node scripts/with_doppler.mjs node --no-warnings tracker/signins.mjs",
    "tracker:switch-check": "node scripts/with_doppler.mjs node --no-warnings tracker/switchCheck.mjs",
    "onboard": "node --disable-warning=ExperimentalWarning scripts/onboard/onboard.mjs",
    "onboard:lanes": "node scripts/onboard/lanes.mjs",
    "onboard:look": "node scripts/with_doppler.mjs node --disable-warning=ExperimentalWarning scripts/onboard/look.mjs",
    "onboard:settings": "node scripts/with_doppler.mjs node --disable-warning=ExperimentalWarning scripts/onboard/settings.mjs",
    "onboard:copy": "node scripts/onboard/copy.mjs",
    "check:syntax": "node scripts/check_syntax.mjs",
    "check:secrets": "node scripts/check_secrets.mjs",
    "check:wording": "node scripts/check_wording.mjs",
    "test": "node --test scripts/lib/*.test.mjs scripts/tracker/*.test.mjs scripts/onboard/*.test.mjs lib/*.test.mjs lib/*.test.js tracker/*.test.mjs",
    "verify": "npm run check:syntax && npm run check:secrets && npm run check:wording && npm test",
    "tracker:test-email": "node --disable-warning=ExperimentalWarning tracker/testEmail.mjs",
    "tracker:test-text": "node scripts/with_doppler.mjs node --disable-warning=ExperimentalWarning tracker/testText.mjs"
  }
}
